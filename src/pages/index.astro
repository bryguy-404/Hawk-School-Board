---
import '@fontsource-variable/manrope';
import '@fontsource-variable/newsreader/wght.css';
import '@fontsource-variable/newsreader/wght-italic.css';
import '../styles/global.css';
import { site } from '../data/site';
import Arrow from '../components/Arrow.astro';
import Wordmark from '../components/Wordmark.astro';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{site.title}</title>
    <meta name="description" content={site.description} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#183e35" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={site.title} />
    <meta property="og:description" content={site.description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body id="top">
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header page-width flex flex-wrap items-center justify-between gap-x-8 gap-y-4">
      <a class="wordmark-link" href="#top" aria-label="Hawkins for Schools — back to top"><Wordmark /></a>
      <nav aria-label="Main navigation">
        <ul class="header-nav flex items-center gap-6 sm:gap-10" role="list">
          <li><a href="#what-i-believe">{site.beliefsHeading}</a></li>
          <li><a href="#priorities">{site.prioritiesHeading}</a></li>
        </ul>
      </nav>
    </header>

    <main id="main" tabindex="-1">
      <section class="hero page-width" aria-labelledby="page-title">
        <div class="hero-rule" aria-hidden="true"><span></span><span></span><span></span></div>
        <h1 id="page-title" class="hero-title">
          <span>Hawkins</span>{' '}
          <span class="hero-title-second">for <em>Schools</em></span>
        </h1>
        <div class="hero-bottom flex flex-wrap items-center justify-end gap-4">
          <a class="section-button" href="#what-i-believe">{site.beliefsHeading}<Arrow /></a>
          <a class="text-link" href="#priorities">{site.prioritiesHeading}<Arrow /></a>
        </div>
      </section>

      <section id="what-i-believe" class="beliefs section-anchor" aria-labelledby="beliefs-title" tabindex="-1">
        <div class="page-width beliefs-layout grid gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20">
          <div class="section-heading">
            <span class="section-index" aria-hidden="true">01</span>
            <h2 id="beliefs-title">What I <em>believe</em></h2>
            <div class="heading-rule" aria-hidden="true"></div>
          </div>
          <div class="belief-list">
            {site.beliefs.map((belief, index) => (
              <article class="belief">
                <span class="belief-index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
                <div>
                  <h3>{belief.title}</h3>
                  <p>{belief.body}</p>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section id="priorities" class="priorities section-anchor page-width" aria-labelledby="priorities-title" tabindex="-1">
        <div class="priorities-heading flex items-baseline gap-6 sm:gap-10">
          <span class="section-index" aria-hidden="true">02</span>
          <h2 id="priorities-title">{site.prioritiesHeading}</h2>
        </div>
        <ol class="priority-list grid md:grid-cols-2" role="list">
          {site.priorities.map((priority, index) => (
            <li class="priority flex items-start gap-6 sm:gap-8">
              <span class="priority-index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              <p>{priority}</p>
            </li>
          ))}
        </ol>
      </section>
    </main>

    <footer class="site-footer page-width flex flex-wrap items-center justify-between gap-8">
      <a class="wordmark-link" href="#top" aria-label="Hawkins for Schools — back to top"><Wordmark /></a>
      <a class="text-link" href="#top">Back to top<Arrow direction="up" /></a>
    </footer>
  </body>
</html>
